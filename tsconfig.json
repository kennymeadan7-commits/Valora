{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@previewpay/core": ["packages/core/src/index.ts"],
      "@previewpay/storage-memory": ["packages/storage-memory/src/index.ts"],
      "@previewpay/provider-mock": ["packages/provider-mock/src/index.ts"],
      "@previewpay/testing": ["packages/testing/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "vitest.config.ts"
  ]
}
