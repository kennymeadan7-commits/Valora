# ---------------------------------------------------------------------------
# Copie ce fichier en .env — jamais l'inverse. `.env` est ignoré par git.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# --- Persistance : memory | prisma ---
STORAGE=memory

# --- Base de données (docker compose up -d db) ---
DATABASE_URL=postgresql://previewpay:previewpay@localhost:5432/previewpay?schema=public

# --- PreviewPay ---
# Secret qui signe les liens de téléchargement (génère-le : openssl rand -hex 32)
PREVIEWPAY_DOWNLOAD_SECRET=change-me
PREVIEWPAY_DOWNLOAD_TTL_SECONDS=300
PREVIEWPAY_MAX_REGENERATIONS=2
PREVIEWPAY_PUBLIC_URL=http://localhost:3000

# --- Paiement : mock | fedapay ---
PAYMENT_PROVIDER=mock

# --- FedaPay sandbox (jalon 3) ---
FEDAPAY_ENV=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
# Secret de l'endpoint webhook du tableau de bord (préfixe wh_sandbox_)
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_CALLBACK_URL=
