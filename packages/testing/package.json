{
  "name": "@previewpay/testing",
  "version": "0.1.0",
  "description": "Suites de contrat PreviewPay pour valider un Storage ou un PaymentProvider (Vitest).",
  "keywords": [
    "previewpay",
    "mobile-money",
    "xof",
    "pay-per-deliverable",
    "ai",
    "testing",
    "contract",
    "vitest"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kennymeadan7-commits/Valora.git",
    "directory": "packages/testing"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs testing",
    "prepack": "node ../../scripts/build-packages.mjs testing"
  },
  "dependencies": {
    "@previewpay/core": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  }
}
