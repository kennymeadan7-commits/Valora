{
  "name": "@previewpay/react",
  "version": "0.1.0",
  "description": "Paquet React PreviewPay : hook usePreviewPay et composant <PreviewPaywall />.",
  "license": "MIT",
  "keywords": [
    "previewpay",
    "mobile-money",
    "xof",
    "pay-per-deliverable",
    "ai",
    "react",
    "hook",
    "paywall"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kennymeadan7-commits/Valora.git",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs react",
    "prepack": "node ../../scripts/build-packages.mjs react"
  },
  "dependencies": {
    "@previewpay/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "react-dom": "^19.3.1",
    "react": "^19.3.1"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  }
}
