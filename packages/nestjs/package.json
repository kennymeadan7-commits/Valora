{
  "name": "@previewpay/nestjs",
  "version": "0.1.0",
  "description": "Module NestJS PreviewPay : 6 endpoints (livrables, paiement, refus, téléchargement signé, webhook).",
  "license": "MIT",
  "keywords": [
    "previewpay",
    "mobile-money",
    "xof",
    "pay-per-deliverable",
    "ai",
    "nestjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kennymeadan7-commits/Valora.git",
    "directory": "packages/nestjs"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs nestjs",
    "prepack": "node ../../scripts/build-packages.mjs nestjs"
  },
  "dependencies": {
    "@previewpay/core": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/testing": "^12.5.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  }
}
