{
  "name": "@previewpay/core",
  "version": "0.1.0",
  "description": "Cœur PreviewPay : machine à états du livrable, moteur aperçu → paiement → déblocage, sans framework.",
  "license": "MIT",
  "keywords": [
    "previewpay",
    "mobile-money",
    "xof",
    "pay-per-deliverable",
    "ai",
    "state-machine",
    "paywall"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kennymeadan7-commits/Valora.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs core",
    "prepack": "node ../../scripts/build-packages.mjs core"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  }
}
